
# Rendered doc artifacts are derived from the markdown next to them; the
# markdown is the only tracked source of truth. Render into docs/, never the root.
# See dev/standards/repo-layout.md, "Rendered doc artifacts".
docs/**/*.pdf
docs/**/*.html

# Python and uv
__pycache__/
*.py[cod]
.venv/
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
# Run output directories, wherever kpa run --out puts them, except the committed sweep runs under
# results/ (this.i 9jmmwx2c). An unanchored runs/ once matched results/privacy-sweeps/runs/ too,
# so those runs were silently left out of the commit that published them.
runs/
!/results/**/runs/

# The documentation site: its assembled source and the built HTML (scripts/site-source,
# zensical.toml). Both are generated at build time and never committed.
_site/
